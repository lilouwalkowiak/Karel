# Projet : Karel le jardinier

définir ramasser_ligne:
    tant que balise_ici:
        ramasser_balise

    tant que devant_libre:
        avancer
        tant que balise_ici:
            ramasser_balise
   

définir tourner_droite:
    Répéter 3 fois:
        tourner_gauche

définir changer_ligne:
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tourner_gauche
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tourner_droite

définir aller_au_coin:
    tant que pas regarde_sud:
        tourner_gauche
    tant que devant_libre:
        avancer
    tourner_droite
    tant que devant_libre:
        avancer
    tant que pas regarde_est:
        tourner_gauche

aller_au_coin
Répéter 5 fois:
    ramasser_ligne
    changer_ligne
