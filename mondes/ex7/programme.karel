# Projet : Karel le jardinier

définir ramasser_ligne:
    si balise_ici:
        ramasser_balise

    tant que devant_libre:
        avancer
        si balise_ici:
            ramasser_balise
            tant que balise_ici:
                ramasser_balise
   

définir tourner_droite:
    Répéter 3 fois:
        tourner_gauche

définir changer_ligne:
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tourner_gauche
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tourner_droite



ramasser_ligne
changer_ligne
ramasser_ligne
changer_ligne
ramasser_ligne
changer_ligne
ramasser_ligne
